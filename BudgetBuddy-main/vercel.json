{
    "version": 2,
    "builds": [
      {
        "src": "frontend/package.json", 
        "use": "@vercel/static-build",
        "config": {
          "distDir": "public"
        }
      },
      {
        "src": "backend/server.js", 
        "use": "@vercel/node"
      }
    ],
    "routes": [
      {
        "src": "/(.*)", 
        "dest": "public/$1"
      },
      {
        "src": "/api/(.*)", 
        "dest": "/backend/server.js"
      }
    ]
  }
  